# Environment Configuration
ENVIRONMENT=development

# Airflow Configuration
AIRFLOW_HOME=/opt/airflow
AIRFLOW_UID=1000
AIRFLOW__CORE__FERNET_KEY='fernet-key-placeholder' # Replace with a secure key in production
AIRFLOW__API_AUTH__JWT_SECRET='dev-secret-key'  # Replace with a secure key in production
AIRFLOW__API__SECRET_KEY='dev-api-secret'  # Replace with a secure key in production
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASS=admin  # Replace with secure credentials in production
AIRFLOW_ADMIN_EMAIL='example@example.com'

# Database Configuration
DATABASE_URL=postgresql://warehouse_user:warehouse_pass@localhost:5432/commodity_warehouse
AIRFLOW_CONN_POSTGRES_DEFAULT=postgresql://airflow:airflow@localhost:5432/airflow

# S3/MinIO Configuration
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_BRONZE=bronze-layer
MINIO_BUCKET_SILVER=silver-layer

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=your-email@example.com

# Feature Flags
ENABLE_QUALITY_CHECKS=true
ENABLE_MONITORING=true
ENABLE_ALERTING=true
ENABLE_AGGREGATES=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
