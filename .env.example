# Environment state just for info
ENVIRONMENT=production

# Airflow Configuration
AIRFLOW_HOME=/home/kivaschenko/commodity-analytic
AIRFLOW_UID=1000
AIRFLOW__CORE__FERNET_KEY='' # Replace with a secure key in production
AIRFLOW__API_AUTH__JWT_SECRET='' # Replace with a secure key in production
AIRFLOW__API__SECRET_KEY='' # Replace with a secure key in production
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASS='' # Replace with secure credentials in production
AIRFLOW_ADMIN_EMAIL=''

# Database Configuration
DATABASE_URL=postgresql://warehouse_user:warehouse_password@localhost:5432/commodity_warehouse
AIRFLOW_CONN_POSTGRES_DEFAULT=postgresql://airflow:airflow@localhost:5432/airflow

# Other
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost:5432/airflow
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False
AIRFLOW__CORE__LOAD_EXAMPLES='false'
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@localhost:5432/airflow
AIRFLOW__CORE__DAGS_FOLDER=/home/kivaschenko/commodity-analytic/dags
AIRFLOW__CELERY__BROKER_URL=redis://:@localhost:6379/0
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://localhost:8080/execution/

# Common Object Storage Configuration
STORAGE_TYPE=hetzner
STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=eu-central
STORAGE_BUCKET_BRONZE=bronze-layer
STORAGE_BUCKET_SILVER=silver-layer

# Slack Notifications
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/*********"

# Email Configuration (Mailtrap)
SMTP_SERVER=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASSWORD="**************"
ALERT_EMAIL=no-reply@graintrade.info

# Feature Flags
ENABLE_QUALITY_CHECKS=true
ENABLE_MONITORING=true
ENABLE_ALERTING=true
ENABLE_AGGREGATES=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Telegram
TELEGRAM_TOKEN="****************"
TELEGRAM_CHANNEL_ID="@**********"
