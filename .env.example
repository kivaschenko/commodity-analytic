# Environment Configuration
ENVIRONMENT=development

# Airflow Configuration
AIRFLOW_HOME=/app
AIRFLOW_UID=1000

# Database Configuration
DATABASE_URL=postgresql://warehouse_user:warehouse_pass@warehouse-db:5432/commodity_warehouse
AIRFLOW_CONN_POSTGRES_DEFAULT=postgresql://airflow:airflow@postgres:5432/airflow

# S3/MinIO Configuration
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_BRONZE=bronze-layer
MINIO_BUCKET_SILVER=silver-layer

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=your-email@example.com

# Feature Flags
ENABLE_QUALITY_CHECKS=true
ENABLE_MONITORING=true
ENABLE_ALERTING=true
ENABLE_AGGREGATES=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
