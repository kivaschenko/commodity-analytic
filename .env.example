# Local Airflow configuration (host-installed PostgreSQL and Valkey)
AIRFLOW_API_SERVER_PORT=8080
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=False
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@localhost:5432/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow:airflow@localhost:5432/airflow
AIRFLOW__CELERY__BROKER_URL=redis://localhost:6379/0
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://localhost:8080/execution/
AIRFLOW__CORE__FERNET_KEY=replace-with-a-generated-fernet-key
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-a-random-secret
AIRFLOW__API__SECRET_KEY=replace-with-a-random-secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASS=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Local application and warehouse configuration
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/commodity_warehouse
DATA_LAKE_PATH=./data_lake

# Local MinIO configuration
MINIO_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MINIO_BUCKET_BRONZE=bronze-layer
MINIO_BUCKET_SILVER=silver-layer

# Optional notifications
SLACK_WEBHOOK_URL=
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
ALERT_EMAIL=
